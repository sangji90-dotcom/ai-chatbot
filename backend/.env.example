# 필수 - 없으면 앱이 기동하지 않음
JWT_SECRET=          # openssl rand -hex 32
GEMINI_API_KEY=

# 환경
ENV=development      # development | production
DB_PATH=             # 미지정 시 backend/chatbot.db (절대경로 권장)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_PROXY=none   # none | cloudflare

# 비우면 인메모리로 동작 (워커 1개일 때만 안전)
REDIS_URL=
